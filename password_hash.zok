import "hashes/sha256/sha256" as sha256;

def main(
    private u8[8] password,
    u8[32] expected_hash
) -> bool {

    // Compute SHA-256(password)
    u8[32] hash = sha256(password);

    // Enforce equality byte-by-byte
    for u32 i in 0..32 {
        assert(hash[i] == expected_hash[i]);
    }

    return true;
}